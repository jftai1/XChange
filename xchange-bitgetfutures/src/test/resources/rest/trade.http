### Place market order USDT-FUTURES, BTCUSDT
< {%
  import {gen_sign} from 'sign.js'
  gen_sign(request);
%}
POST {{api_host}}/api/v2/mix/order/place-order
ACCESS-KEY: {{api_key}}
ACCESS-SIGN: {{sign}}
ACCESS-TIMESTAMP: {{timestamp}}
ACCESS-PASSPHRASE: {{api_passphrase}}
Content-Type: application/json
paptrading: 1

{
  "productType": "USDT-FUTURES",
  "symbol": "BTCUSDT",
  "marginCoin": "USDT",
  "marginMode": "isolated",
  "side" : "buy",
  "orderType": "market",
  "size": "0.001",
  "clientOid": "b9f0c8a1-52c4-4cb2-8d2a-5f8df95f9c3e"
}

